# --- Database ---------------------------------------------------------------
# Postgres (Supabase: use the pooled "Transaction" URL with ?pgbouncer=true for DATABASE_URL
# and the direct "Session" URL for DIRECT_URL). Locally both can be the same URL.
DATABASE_URL="postgresql://deepdive:deepdive@localhost:5432/deepdive"
DIRECT_URL="postgresql://deepdive:deepdive@localhost:5432/deepdive"
# For SQLite instead: DATABASE_URL="file:./dev.db" and run `npm run db:sqlite`.

# --- Anthropic (server only, never exposed to the browser) -------------------
ANTHROPIC_API_KEY=""
# Optional override. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=""

# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Secrets ------------------------------------------------------------------
# Password for /admin. Use something long.
ADMIN_PASSWORD="change-me-please"
# Random string used to salt IP hashes and sign admin cookies.
APP_SECRET="replace-with-a-long-random-string"
# Vercel cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/topup.
CRON_SECRET="replace-with-another-random-string"
